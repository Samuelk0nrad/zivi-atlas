config_version: 1
control_plane:
  base_url: "https://api.openai.com"
  tunnel_id: "YOUR_TUNNEL_ID"
  api_key: "env:CONTROL_PLANE_API_KEY"
health:
  listen_addr: "127.0.0.1:8091"
admin_ui:
  open_browser: false
log:
  level: info
  format: json
mcp:
  server_urls:
    - channel: main
      url: "https://YOUR_SITE_HOST/api/mcp"
  extra_headers:
    Authorization: "env:ZIVI_AUTHORIZATION"
    OAI-Sites-Authorization: "env:ZIVI_SITES_AUTHORIZATION"
